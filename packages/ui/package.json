{
  "name": "@skeed/ui",
  "version": "0.1.10",
  "description": "Curated Tailwind 3-first flagship UI components for Skeed.",
  "keywords": ["skeed", "react", "tailwind", "ui", "components", "micro-interactions"],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./advanced": {
      "import": "./dist/advanced.js",
      "types": "./dist/advanced.d.ts"
    },
    "./ai": {
      "import": "./dist/ai.js",
      "types": "./dist/ai.d.ts"
    },
    "./data": {
      "import": "./dist/data.js",
      "types": "./dist/data.d.ts"
    },
    "./forms": {
      "import": "./dist/forms.js",
      "types": "./dist/forms.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives.js",
      "types": "./dist/primitives.d.ts"
    },
    "./specialized": {
      "import": "./dist/specialized.js",
      "types": "./dist/specialized.d.ts"
    },
    "./visualization": {
      "import": "./dist/visualization.js",
      "types": "./dist/visualization.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:browser": "playwright test -c playwright.config.ts",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/quality.test.ts --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@skeed/tailwind": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^8.0.11",
    "vitest": "^2.1.8"
  }
}

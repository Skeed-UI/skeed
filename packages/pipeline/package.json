{
  "name": "@skeed/pipeline",
  "version": "0.1.3",
  "description": "Skeed 17-stage NL→design-system pipeline. DAG runner + stage contracts. Each stage is owned by an agent.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./orchestrator": {
      "import": "./dist/orchestrator.js",
      "types": "./dist/orchestrator.d.ts"
    },
    "./stages/*": {
      "import": "./dist/stages/*.js",
      "types": "./dist/stages/*.d.ts"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@skeed/archetypes-loader": "^0.1.0",
    "@skeed/asset-logo-svg": "^0.1.0",
    "@skeed/asset-source-fal": "^0.1.0",
    "@skeed/asset-source-gemini-image": "^0.1.0",
    "@skeed/asset-source-open-doodles": "^0.1.0",
    "@skeed/asset-source-openai-image": "^0.1.0",
    "@skeed/asset-source-pexels": "^0.1.0",
    "@skeed/asset-source-replicate": "^0.1.0",
    "@skeed/asset-source-undraw": "^0.1.0",
    "@skeed/asset-source-unsplash": "^0.1.0",
    "@skeed/assets-router": "^0.1.0",
    "@skeed/contracts": "^0.1.0",
    "@skeed/demographics-loader": "^0.1.0",
    "@skeed/guards": "^0.1.0",
    "@skeed/landing-options": "^0.1.0",
    "@skeed/llm-provider-local": "^0.1.0",
    "@skeed/llm-router": "^0.1.0",
    "@skeed/mcp-server": "^0.1.0",
    "@skeed/research-bridge": "^0.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
